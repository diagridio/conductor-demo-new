    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug OrderProcessorService",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "Build OrderProcessorService",
            "postDebugTask": "Dapr Stop OrderProcessorService",
            "program": "${workspaceFolder}/dotnet/OrderProcessorService/bin/Debug/net8.0/OrderProcessorService.dll",
            "args": [],
            "cwd": "${workspaceFolder}/dotnet/OrderProcessorService",
            "stopAtEntry": false,
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "http://*:5700",
                "DAPR_HTTP_PORT": "5780",
                "DAPR_GRPC_PORT": "5701"
            }
        },
    ],
    "compounds": [
        {
            "name": "Debug All Services",
            "configurations": [
                "Debug OrderProcessorService"
            ]
        },
    ]
