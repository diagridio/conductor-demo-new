{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build OrderProcessorWorkflow",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/dotnet/OrderProcessorWorkflow",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "dependsOn": "Dapr OrderProcessorWorkflow",
            "problemMatcher": "$msCompile",
            "group": "build"
        },
        {
            "label": "Build Solution",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Dapr OrderProcessorWorkflow",
            "command": "dapr",
            "args": [
                "run",
                "--app-id",
                "order-processor-workflow",
                "--components-path",
                "${workspaceFolder}/components/local",
                "--app-port",
                "5700",
                "--dapr-grpc-port",
                "5701",
                "--dapr-http-port",
                "5780"
            ],
            "isBackground": true,
            "problemMatcher": {
                "pattern": [
                    {
                        "regexp": ".",
                        "file": 1,
                        "location": 2,
                        "message": 3
                    }
                ],
                "background": {
                    "beginsPattern": "^.*Starting Dapr.*",
                    "endsPattern": "^.*You're up and running!.*"
                }
            }
        },
        {
            "label": "Dapr Stop OrderProcessorWorkflow",
            "command": "dapr",
            "args": [
                "stop",
                "order-processor-workflow"
            ]
        },
        {
            "label": "Dapr (All Services)",
            "dependsOn": [
                "Dapr OrderProcessorWorkflow"
            ],
            "problemMatcher": []
        }
    ]
}